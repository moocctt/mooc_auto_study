{
  "name": "@mooc/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:generate:dev": "prisma generate --schema prisma/schema.sqlite.prisma",
    "db:push": "prisma db push --schema prisma/schema.sqlite.prisma",
    "db:generate:prod": "prisma generate --schema prisma/schema.postgres.prisma",
    "db:deploy": "prisma migrate deploy --schema prisma/schema.postgres.prisma"
  },
  "prisma": {
    "schema": "prisma/schema.sqlite.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.5.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "prisma": "^6.5.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
