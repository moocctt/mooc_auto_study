// 生产 schema（PostgreSQL）。开发期 SQLite 版在 schema.sqlite.prisma，
// 两份 model 定义保持逐字段一致。
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String   @id @default(uuid())
  username            String   @unique
  passwordHash        String // scrypt: salt:hash (hex)
  platformUsername    String?
  platformPasswordEnc String? // AES-256-GCM(PLATFORM_ENC_KEY)
  platformCompany     String   @default("全行业")
  createdAt           DateTime @default(now())
  sessions            Session[]
}

model Session {
  id        String   @id // sha256(token) hex
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model EngineRun {
  id        String    @id @default(uuid())
  userId    String
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  trigger   String    @default("manual") // manual | schedule
  reason    String?   // completed | quota | stopped | error
  submitted Int?

  @@index([userId, startedAt])
}

model EngineSchedule {
  userId     String  @id
  enabled    Boolean @default(false)
  hour       Int     @default(9)
  minute     Int     @default(0)
  lastRunDay String?

  @@index([enabled])
}
