# 复制为 .env 后填账密（.env 已在 .gitignore，不会入库）
# 放在哪都可以：项目根目录 / $TOBACCO_HOME / data/ 都会读，先找到的优先

# —— 单账号（默认账号，key=default）——
MOOC_USER=你的登录手机号
MOOC_PWD=你的登录密码

# —— 多账号（两行一组，可重复多组；key 就是用户名）——
# MOOC_LOGIN=13800000000
# MOOC_PASS=密码1
# MOOC_LOGIN=13900000000
# MOOC_PASS=密码2

# —— 可选 ——
# 数据目录（token 缓存、今日额度记账都放这里），默认 data/
# TOBACCO_HOME=/path/to/data
# 扫码登录的会话串（一般不用填，程序会自动取）
# MOOC_HASH_KEY=xxx
