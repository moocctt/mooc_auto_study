# 烟草网络学院自动学习 —— 账号配置模板
# 复制本文件为 .env（.env 不会被提交到 git），然后编辑成你的真实账密。
#   cp .env.example .env

# ── 方式一：单账号 ────────────────────────────
MOOC_USER=你的账号
MOOC_PWD=你的密码

# ── 方式二：多账号（每 2 行一组，可追加任意多组，无需命名）──
# 登录后自动显示平台真实姓名, --user 用户名或真实姓名均可
#
# MOOC_LOGIN=13800000001
# MOOC_PASS=密码1
#
# MOOC_LOGIN=13800000002
# MOOC_PASS=密码2
#
# 使用: python mooc_auto_study.py --todo --user 13800000001
#       TUI 里按 u 切换账号、按 n 添加账号
